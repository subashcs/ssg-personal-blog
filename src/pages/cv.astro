---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { SITE } from '~/config.mjs';
import Layout from '~/layouts/PageLayout.astro';
import { getCanonical, getCvPermalink } from '~/utils/permalinks';
import cvPreview from '~/assets/images/cv-preview.webp';

const meta = {
	title: `Curriculum Vitae — ${SITE.name}`,
	description: 'Preview Subash Chandra Sapkota’s CV and request a copy by email.',
	canonical: getCanonical(getCvPermalink()),
};
---

<Layout {meta}>
	<section class="px-4 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
		<header class="max-w-3xl mx-auto text-center mb-10">
			<h1 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
				Curriculum Vitae
			</h1>
			<p class="text-lg text-gray-600 dark:text-slate-400">
				The lower half of this preview is blurred for privacy. Request a copy and I will email you the full CV.
			</p>
			<div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
				<button type="button" class="btn btn-primary" data-aw-open-request-cv>
					<Icon name="tabler:mail" class="w-5 h-5 mr-1 -ml-1.5" />
					Request CV
				</button>
			</div>
		</header>

		<div
			class="relative rounded-lg border border-gray-200 dark:border-zinc-700 overflow-hidden bg-gray-50 dark:bg-zinc-800"
		>
			<Image
				src={cvPreview}
				alt="Partially blurred preview of Subash Chandra Sapkota’s CV"
				class="w-full h-auto select-none pointer-events-none"
				loading="eager"
				quality="high"
				format="webp"
			/>
			<div
				class="absolute inset-x-0 bottom-0 h-1/2 flex flex-col items-center justify-end px-4 pb-10 sm:pb-14 bg-gradient-to-t from-white via-white/80 to-transparent dark:from-zinc-900 dark:via-zinc-900/80"
			>
				<p class="mb-4 text-sm sm:text-base text-gray-700 dark:text-slate-300 text-center">
					The rest of this CV is hidden for privacy.
				</p>
				<button type="button" class="btn btn-primary" data-aw-open-request-cv>
					<Icon name="tabler:mail" class="w-5 h-5 mr-1 -ml-1.5" />
					Request CV
				</button>
			</div>
		</div>
	</section>
</Layout>
