---
import { getPermalink } from '~/utils/permalinks';
---

<div
	class="hidden md:block bg-primary-50 dark:bg-zinc-950 dark:border-zinc-800 dark:text-slate-300 border-b border-primary-100 text-md px-3 py-2 text-gray-800 overflow-hidden whitespace-nowrap text-ellipsis"
>
	<span class="text-xs py-0.5 px-1.5 rounded bg-primary-100 text-primary-800 dark:bg-primary-500/20 dark:text-primary-300 font-semibold"
		>New Article</span
	>
	<a
		href={getPermalink('useful-resources-to-create-websites', 'post')}
		class="hover:underline text-gray-700 dark:text-slate-300"
		>Useful tools and resources to create a professional website »</a
	>
</div>
