---
import { Icon } from 'astro-icon';
import { Picture } from '@astrojs/image/components';
import restrokitIcon from '~/assets/images/restro.webp';

const items = [
	{
		title: 'Infrainit',
		description:
			'A B2C ecommerce web app to buy and sell construction material. Browse house architectures and estimate materials and pricing.',
		pls: ['php', 'html', 'jquery', 'css'],
		link: 'https://github.com/subashcs/infrainit',
		icon: 'flat-color-icons:home',
	},
	{
		title: 'Restrokit',
		description:
			'Restaurant management system with order management, table booking, and restaurant search and review.',
		pls: ['Node.js', 'Next.JS', 'Supabase', 'ShadcnUI'],
		link: 'https://restrokit.com',
		img: restrokitIcon,
	},
	{
		title: 'Baaghchal',
		description:
			'Cross platform game application of Nepali popular game baaghchal',
		icon: 'flat-color-icons:grid',
		pls: ['React JS', 'React Native', 'Firebase'],
		link: 'https://baghchal.onrender.com',
		github: "https://github.com/subashcs/baaghchal",
	},
	{
		title: 'PersonalBlogAPI',
		description:
			'Open Source GraphQL API for personal portfolio with admin panel features. Dockerized for easier deployment node-alpine base image.',
		pls: ['GraphQL', 'node js', 'mongoDB'],
		icon: 'flat-color-icons:address-book',
		link: 'https://gitlab.com/subashsapkota59/subashcsAPI',

	},
	{
		title: 'VisitorEntrySystem',
		pls: ['Node JS', 'Angular JS', 'MongoDB'],
		description:
			'Daily visitor entry tracking system',
		icon: 'flat-color-icons:voice-presentation',
		link: 'https://github.com/subashcs/infrainit',
	},
];
---

<section class="relative" id="projects">
	<div class="absolute inset-0 bg-primary-50 dark:bg-zinc-900 pointer-events-none mb-32" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
		<div class="py-4 pt-8 sm:py-6 lg:py-8 lg:pt-12">
			<div class="mb-8 text-center">
				<p class="text-base text-primary-600 dark:text-primary-200 font-semibold tracking-wide uppercase">Projects</p>
				<h2 class="text-4xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
					Take a look into these cool softwares !
				</h2>
				<p class="max-w-3xl mx-auto text-center text-xl text-gray-600 dark:text-slate-400">
					Web, Mobile and Desktop applications
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 items-start my-12 dark:text-white">
				{
					items.map(({ title, description, icon, img, pls, link }) => (
						<div class="relative flex flex-col p-4 bg-white dark:bg-zinc-900 rounded shadow-xl hover:shadow-lg transition dark:border dark:border-slate-800">
							<a href={link} target="_blank">
								<div class="flex items-center mb-4">
									{icon && <Icon name={icon} class="w-12 h-12" />}
									{img && <Picture src={img} class="w-12 h-12" alt={title} widths={[48, 96]} aspectRatio="1:1" sizes="48px" />}
		
									<div class="ml-4 text-xl font-bold">{title}</div>
								</div>
							</a>
							<p class="text-gray-500 dark:text-gray-400 text-lg h-24 overflow-scroll">{description}</p>
							<ul class="list-none block gap-2 text-gray-500 dark:text-gray-400 text-sm mt-2">{pls?.map((tag)=>(
								<li class="bg-gray-200 dark:bg-slate-700 w-auto m-1 px-1 rounded inline-block">{tag}</li>
							))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>