---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Card from '~/components/atoms/Card.astro';
import restrokitIcon from '~/assets/images/restro.webp';

const items = [
	{
		title: 'Infrainit',
		description:
			'A B2C ecommerce web app to buy and sell construction material. Browse house architectures and estimate materials and pricing.',
		pls: ['php', 'html', 'jquery', 'css'],
		link: 'https://github.com/subashcs/infrainit',
		icon: 'flat-color-icons:home',
	},
	{
		title: 'Restrokit',
		description:
			'Restaurant management system with order management, table booking, and restaurant search and review.',
		pls: ['Node.js', 'Next.JS', 'Supabase', 'ShadcnUI'],
		link: 'https://restrokit.com',
		img: restrokitIcon,
	},
	{
		title: 'Baaghchal',
		description: 'Cross platform game application of Nepali popular game baaghchal',
		icon: 'flat-color-icons:grid',
		pls: ['React JS', 'React Native', 'Firebase'],
		link: 'https://baghchal.onrender.com',
		github: 'https://github.com/subashcs/baaghchal',
	},
	{
		title: 'PersonalBlogAPI',
		description:
			'Open Source GraphQL API for personal portfolio with admin panel features. Dockerized for easier deployment node-alpine base image.',
		pls: ['GraphQL', 'node js', 'mongoDB'],
		icon: 'flat-color-icons:address-book',
		link: 'https://gitlab.com/subashsapkota59/subashcsAPI',
	},
	{
		title: 'VisitorEntrySystem',
		pls: ['Node JS', 'Angular JS', 'MongoDB'],
		description: 'Daily visitor entry tracking system',
		icon: 'flat-color-icons:voice-presentation',
		link: 'https://github.com/subashcs/infrainit',
	},
];
---

<section class="section-reveal relative" id="projects">
	<div class="absolute inset-0 bg-gray-50 dark:bg-zinc-950/40 pointer-events-none" aria-hidden="true"></div>
	<div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 lg:py-20">
		<div class="mb-10 text-center">
			<p class="text-base text-primary-600 dark:text-primary-400 font-semibold tracking-wide uppercase">Projects</p>
			<h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mt-1 mb-3 font-heading text-gray-900 dark:text-slate-100">
				Take a look into these cool softwares !
			</h2>
			<p class="max-w-2xl mx-auto text-lg text-gray-600 dark:text-slate-400">
				Web, mobile, and desktop applications
			</p>
		</div>
		<div class="grid gap-5 sm:gap-6 md:grid-cols-2">
			{
				items.map(({ title, description, icon, img, pls, link, github }) => (
					<Card hover class="group relative flex flex-col p-5 sm:p-6">
						<a
							href={link}
							target="_blank"
							rel="noopener noreferrer"
							class="absolute inset-0 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
							aria-label={`${title} (opens in a new tab)`}
						/>
						<div class="flex items-start gap-4">
							<div class="grid place-items-center w-12 h-12 shrink-0 rounded-xl bg-gray-100 dark:bg-zinc-700/60 ring-1 ring-gray-200/80 dark:ring-zinc-600/60">
								{icon && <Icon name={icon} class="w-7 h-7" />}
								{img && <Image src={img} class="w-8 h-8 object-contain" alt="" />}
							</div>
							<div class="min-w-0 flex-1">
								<h3 class="text-xl font-bold text-gray-900 dark:text-slate-100 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">
									{title}
									<Icon
										name="tabler:arrow-up-right"
										class="inline-block w-5 h-5 ml-0.5 align-text-top text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-300"
									/>
								</h3>
								<p class="mt-2 text-gray-600 dark:text-slate-400 leading-relaxed">{description}</p>
							</div>
						</div>
						<ul class="relative z-10 mt-5 flex flex-wrap gap-2">
							{pls?.map((tag) => (
								<li class="px-2.5 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 dark:bg-zinc-700/80 dark:text-slate-300">
									{tag}
								</li>
							))}
							{github && (
								<li>
									<a
										href={github}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-full bg-gray-900 text-white dark:bg-slate-100 dark:text-zinc-900 hover:bg-gray-700 dark:hover:bg-white"
									>
										<Icon name="tabler:brand-github" class="w-3.5 h-3.5" />
										Code
									</a>
								</li>
							)}
						</ul>
					</Card>
				))
			}
		</div>
	</div>
</section>
