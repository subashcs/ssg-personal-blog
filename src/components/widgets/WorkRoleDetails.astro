---
import Card from '~/components/atoms/Card.astro';

interface Project {
  title: string;
  description: string;
  tools?: string[];
  toolsUsed?: string[];
}

interface Props {
  bulletPoints?: string[];
  projects?: Project[];
  tools?: string[];
}

const { bulletPoints = [], projects = [], tools = [] } = Astro.props;

const badges = [
  'bg-red-100 text-red-800 dark:bg-red-500/15 dark:text-red-300',
  'bg-green-100 text-green-800 dark:bg-green-500/15 dark:text-green-300',
  'bg-blue-100 text-blue-800 dark:bg-blue-500/15 dark:text-blue-300',
  'bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300',
  'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-300',
  'bg-purple-100 text-purple-800 dark:bg-purple-500/15 dark:text-purple-300',
];
---

{
  bulletPoints.length > 0 && (
    <ul class="list-disc list-inside mt-2 text-gray-600 dark:text-slate-400">
      {bulletPoints.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  )
}

{
  projects.length > 0 && (
    <div class="mt-4">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-200">Projects:</h3>
      {projects.map((project) => {
        const projectTools = project.tools || project.toolsUsed || [];
        return (
          <Card class="mt-2 p-4 sm:p-5">
            <h4 class="font-bold text-gray-900 dark:text-slate-100">{project.title}</h4>
            <p class="text-gray-600 dark:text-slate-400 mt-1">{project.description}</p>
            {projectTools.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {projectTools.map((tool, i) => (
                  <span class={`inline-block px-2.5 py-1 text-xs font-medium rounded-full ${badges[i % badges.length]}`}>
                    {tool}
                  </span>
                ))}
              </div>
            )}
          </Card>
        );
      })}
    </div>
  )
}

{
  tools.length > 0 && (
    <div class="mt-4">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-200">Tools & Technologies:</h3>
      <div class="flex flex-wrap gap-2 mt-2">
        {tools.map((tool, i) => (
          <span class={`inline-block px-2.5 py-1 text-xs font-medium rounded-full ${badges[i % badges.length]}`}>
            {tool}
          </span>
        ))}
      </div>
    </div>
  )
}
