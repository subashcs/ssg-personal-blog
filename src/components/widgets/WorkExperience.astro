              </div>
            </div>
            <div class="w-px h-full bg-gray-300 dark:bg-zinc-700" />
          </div>
          <div class="pt-1 pb-8">
            <p class="text-xl font-bold text-gray-900 dark:text-slate-100">Today</p>
          </div>
        </div>

        {
          companies.map(({ employer, roles }, index) => {
            const first = roles[0];
            const last = roles[roles.length - 1];
            const types = [...new Set(roles.map((role) => formatType(role.type)))];
            const sharedTools = [...new Set(roles.flatMap(toolsFor))];
            return (
              <div class="flex">
                <div class="flex flex-col items-center mr-3 sm:mr-4">
                  <div>
                    <div class="flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full border-blue-600 dark:border-blue-500 border-2">
                      <Icon name="tabler:building" class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 dark:text-blue-400" />
                    </div>
                  </div>
                  <div class:list={['w-px h-full', index < companies.length - 1 ? 'bg-gray-300 dark:bg-zinc-700' : 'bg-gradient-to-b from-gray-300 to-transparent dark:from-zinc-700']} />
                </div>

                <div class="min-w-0 flex-1 pt-1 pb-10">
                  <details class="experience-entry group" open={index < 2}>
                    <summary class="flex items-start justify-between gap-3 rounded-lg cursor-pointer list-none -ml-2 px-2 py-1 hover:bg-gray-50 dark:hover:bg-zinc-800/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                      <div class="min-w-0">
                        <p class="text-xl font-bold text-gray-900 dark:text-slate-100">{employer}</p>
                        <p class="mt-1 text-gray-500 dark:text-slate-400">
                          {roles.map((role) => role.title).join(' · ')}
                        </p>
                        <p class="mt-0.5 text-sm text-gray-500 dark:text-slate-400">
                          {formatDate(last.fromDate)} – {formatDate(first.toDate)} · {types.join(' / ')} · {formatDuration(last.fromDate, first.toDate)}
                        </p>
                      </div>
                      <span class="mt-1 inline-flex items-center gap-1 shrink-0 text-sm font-medium text-blue-700 dark:text-blue-300">
                        <span class="hidden group-open:inline">Hide</span>
                        <span class="group-open:hidden">Show</span>
                        <Icon name="tabler:chevron-down" class="w-5 h-5 transition-transform duration-200 group-open:rotate-180" />
                      </span>
                    </summary>

                    <ol class="mt-5 space-y-6">
                      {roles.map((role, roleIndex) => (
                        <li class="relative">
                          <span
                            class:list={[
                              // Centered on the main timeline line: icon column (w-8 / sm:w-10) plus its right margin.
                              'absolute top-2 -left-[2.125rem] sm:-left-[2.625rem] w-3 h-3 rounded-full ring-4 ring-white dark:ring-zinc-900',
                              roleIndex === 0 ? 'bg-blue-600 dark:bg-blue-400' : 'bg-gray-300 dark:bg-zinc-600',
                            ]}
                            aria-hidden="true"
                          />
                          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <p class="text-lg font-bold text-gray-900 dark:text-slate-100">{role.title}</p>
                          </div>
                          <p class="mt-0.5 text-sm sm:text-base text-gray-500 dark:text-slate-400">
                            {[
                              `${formatDate(role.fromDate)} – ${formatDate(role.toDate)}`,
                              roles.length > 1 && formatDuration(role.fromDate, role.toDate),
                            ]
                              .filter(Boolean)
                              .join(' · ')}
                          </p>
                          <WorkRoleDetails bulletPoints={role.bulletPoints} projects={role.projects} />
                        </li>
                      ))}
                    </ol>

                    <WorkRoleDetails tools={sharedTools} />
                  </details>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .experience-entry > summary {
