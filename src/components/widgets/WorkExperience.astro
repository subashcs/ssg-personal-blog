---

<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl bg-white dark:bg-gray-900">
  <div class="grid gap-6 row-gap-10 md:grid-cols-1">
    <div class="md:pb-6 md:pr-16">
      <h2 class="mb-8 text-3xl lg:text-4xl font-bold font-heading text-gray-900 dark:text-white">Professional Work Experience Highlights</h2>
      <div class="pl-10">
        {
          workExperiences.map((job, index) => {
            const jobBadges = job.toolsUsed || job.tools || [];
            return (
              <div class="flex">
                <div class="flex flex-col items-center mr-4">
                  <div>
                    <div class="flex items-center justify-center w-10 h-10 rounded-full border-primary-600 border-2">
                      <Icon name="tabler:arrow-down" class="w-6 h-6 text-primary-600 dark:text-slate-200" />
                    </div>
                  </div>
                  <div class="w-px h-full bg-gray-300 dark:bg-zinc-500" />
                </div>
                <div class="pt-1 pb-8">
                  <p class="mb-2 text-lg font-normal text-gray-900 dark:text-slate-300">
                    {job.fromDate} - {job.toDate}
                  </p>
                  <p class="mb-2 text-xl font-bold text-gray-900 dark:text-slate-300">
                    {job.title} <span class="text-sm font-normal">({job.type})</span>
                  </p>
                  <p class="mb-2 text-lg font-normal text-gray-900 dark:text-slate-300">{job.employer}</p>
                  
                  {job.bulletPoints && job.bulletPoints.length > 0 && (
                    <ul class="list-disc list-inside mt-2 text-gray-600 dark:text-slate-400">
                      {job.bulletPoints.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}

                  {job.projects && job.projects.length > 0 && (
                    <div class="mt-4">
                      <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-200">Projects:</h3>
                      {job.projects.map((project) => (
                        <div class="mt-2 p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                          <h4 class="font-bold text-gray-800 dark:text-slate-200">{project.title}</h4>
                          <p class="text-gray-600 dark:text-slate-400 mt-1">{project.description}</p>
                          {project.tools && project.tools.length > 0 && (
                            <div class="mt-2 flex flex-wrap gap-2">
                              {project.tools.map((tool, i) => (
                                <span class={`inline-block px-2 py-1 text-xs font-semibold text-${badges[i % badges.length]}-800 bg-${badges[i % badges.length]}-100 dark:text-${badges[i % badges.length]}-100 dark:bg-${badges[i % badges.length]}-800 rounded-full`}>
                                  {tool}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}

                  {jobBadges.length > 0 && (
                    <div class="mt-4">
                      <h3 class="text-lg font-semibold text-gray-800 dark:text-slate-200">Tools & Technologies:</h3>
                      <div class="flex flex-wrap gap-2 mt-2">
                        {jobBadges.map((tool, i) => (
                          <span class={`inline-block px-2 py-1 text-xs font-semibold text-${badges[i % badges.length]}-800 bg-${badges[i % badges.length]}-100 dark:text-${badges[i % badges.length]}-100 dark:bg-${badges[i % badges.length]}-800 rounded-full`}>
                            {tool}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }

        <div class="flex">
          <div class="flex flex-col items-center mr-4">
            <div>
              <div
                class="flex items-center justify-center w-10 h-10 rounded-full border-primary-600 border-2 bg-primary-600"
              >
                <Icon name="tabler:check" class="w-6 h-6 text-white dark:text-slate-200" />
              </div>
            </div>
          </div>
          <div class="pt-1">
            <p class="mb-2 text-xl font-bold text-gray-900 dark:text-slate-300">Today</p>
            <p class="text-gray-600 dark:text-slate-400"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>