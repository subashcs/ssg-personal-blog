type Job = (typeof workExperiences)[number];

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

// Dates are written loosely ("July 2026", "2020 Nov", "Present"); reduce them to a month count.
// "Present" resolves at build time, so durations refresh on every deploy.
const toMonthNumber = (value: string) => {
  if (/present/i.test(value)) {
    const now = new Date();
    return now.getFullYear() * 12 + now.getMonth();
  }
  const year = Number(value.match(/\d{4}/)?.[0]);
  const month = MONTHS.findIndex((name) => value.toLowerCase().includes(name));
  return year * 12 + Math.max(0, month);
};

const formatDate = (value: string) => {
  if (/present/i.test(value)) return 'Present';
  const months = toMonthNumber(value);
  const month = MONTHS[months % 12];
  return `${month[0].toUpperCase()}${month.slice(1)} ${Math.floor(months / 12)}`;
};

const formatType = (type: string) => {
  const normalized = type.trim().toLowerCase().replace(/\s+/g, '-');
  return normalized[0].toUpperCase() + normalized.slice(1);
};

const formatDuration = (from: string, to: string) => {
  const total = toMonthNumber(to) - toMonthNumber(from) + 1;
  const years = Math.floor(total / 12);
  const months = total % 12;
  return [years && `${years} yr${years > 1 ? 's' : ''}`, months && `${months} mo${months > 1 ? 's' : ''}`]
    .filter(Boolean)
    .join(' ');
};

const companies = workExperiences.reduce<{ employer: string; roles: Job[] }[]>((groups, job) => {
  const current = groups.at(-1);
  if (current?.employer === job.employer) current.roles.push(job);
  else groups.push({ employer: job.employer, roles: [job] });
  return groups;
}, []);

const toolsFor = (job: Job) => ('toolsUsed' in job && job.toolsUsed) || ('tools' in job && job.tools) || [];
---

<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
