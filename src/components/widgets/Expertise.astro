---
import { Icon } from 'astro-icon/components';
import Card from '~/components/atoms/Card.astro';
import SectionTitle from '~/components/atoms/SectionTitle.astro';

const items = [
	[
		{
			title: 'Web Application Development',
			description:
				'Design your web apps, showcase your products, build your vision to power your growth.',
			icon: 'tabler:brand-tailwind',
		},
		{
			title: 'Mobile Application Development',
			description:
				'Custom mobile app development to resolve your business needs.',
			icon: 'tabler:components',
		}
	],
	[
		{
			title: 'Technical Support',
			description:
				'Technical consultation, maintenance and support for your business softwares.',
			icon: 'tabler:arrows-right-left',
		},
		{
			title: 'AI Integration',
			description:
				'Integrate LLMs and AI agents into your products and workflows to automate processes and extract insights from your data.',
			icon: 'tabler:sparkles',
		}
	],
];
---

<section class="section-reveal" id="features">
	<div class="px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20">
		<SectionTitle eyebrow="Technical Knowledge" title="View my Expertise" />
		<div class="grid gap-5 sm:grid-cols-2">
			{
				items.flat().map(({ title, description, icon }) => (
					<Card class="flex gap-4 p-5 sm:p-6">
						<div class="grid place-items-center w-12 h-12 shrink-0 rounded-xl bg-blue-600 dark:bg-blue-500/20">
							{icon && <Icon name={icon} class="w-6 h-6 text-white dark:text-blue-300 icon-light" />}
						</div>
						<div class="min-w-0">
							<h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-slate-100">{title}</h3>
							<p class="text-gray-600 dark:text-slate-400">{description}</p>
						</div>
					</Card>
				))
			}
		</div>
	</div>
</section>
