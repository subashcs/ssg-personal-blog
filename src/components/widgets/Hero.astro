---
import { Icon } from 'astro-icon/components';
import TypingAnimation from './Typing';
import AvatarChat from './AvatarChat.astro';
---

<section class="bg-image">
	<div class="max-w-6xl mx-auto px-4 sm:px-6">
		<div class="max-w-3xl py-12 md:py-20">
			<h1 class="mb-6 text-2xl text-gray-900 dark:text-gray-100 sm:text-4xl md:text-5xl font-bold leading-tight">
				<TypingAnimation client:load />
			</h1>
			<div class="space-y-4 text-base sm:text-lg leading-relaxed text-gray-700 dark:text-slate-300">
				<p>A software engineer driven by curiosity and desire to push the boundaries.</p>
				<p>
					I bring 7+ years of experience working in the Software Development industry with a deep understanding of software
					design and development principles, as well as expertise in various programming languages and frameworks.
				</p>
				<p>
					I believe that diversity is essential to creating truly innovative solutions, and I am committed to bringing my
					unique background and perspective to every project I work on.
				</p>
			</div>
			<p class="mt-8 text-base sm:text-lg">
				Feel free to read, comment and share. 🙂 <span class="text-sm"><em> Enjoy reading 📖 !</em></span>
			</p>
			<div class="flex flex-col sm:flex-row mt-8 gap-4">
				<a class="btn btn-primary w-full sm:w-auto" href="mailto:subashsapkota59@gmail.com" target="_blank" rel="noopener">
					<Icon name="ic:outline-mail" class="w-5 h-5 mr-1 -ml-1.5" /> Message
				</a>
				<button
					type="button"
					class="btn w-full sm:w-auto bg-white text-blue-700 border-blue-200 hover:bg-blue-50 hover:border-blue-300 dark:bg-transparent dark:text-slate-200 dark:border-zinc-600 dark:hover:bg-zinc-800 dark:hover:border-zinc-500"
					data-aw-open-request-cv
				>
					<Icon name="tabler:file-text" class="w-5 h-5 mr-1 -ml-1.5" />
					Request CV
				</button>
			</div>
		</div>
	</div>
	<AvatarChat />
</section>
