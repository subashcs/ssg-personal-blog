---
import { Icon } from 'astro-icon/components';

const email = 'subashsapkota59@gmail.com';
---

<dialog
	id="request-cv-dialog"
	class="w-[calc(100%-2rem)] max-w-lg rounded-lg border border-gray-200 bg-white p-0 text-gray-900 shadow-xl dark:border-zinc-700 dark:bg-zinc-900 dark:text-slate-200 backdrop:bg-black/50"
	aria-labelledby="request-cv-title"
>
	<form id="request-cv-form" class="p-6 sm:p-8">
		<div class="flex items-start justify-between gap-4 mb-4">
			<div>
				<h2 id="request-cv-title" class="text-2xl font-bold font-heading">Request CV</h2>
				<p class="mt-2 text-sm text-gray-600 dark:text-slate-400">
					Share a few details and I’ll email you a copy of my CV.
				</p>
			</div>
			<button
				type="button"
				class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white rounded-lg p-1.5"
				data-aw-close-request-cv
				aria-label="Close request form"
			>
				<Icon name="tabler:x" class="w-5 h-5" />
			</button>
		</div>

		<div class="space-y-4">
			<label class="block">
				<span class="block text-sm font-medium mb-1">Name</span>
				<input
					type="text"
					name="name"
					required
					autocomplete="name"
					class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</label>
			<label class="block">
				<span class="block text-sm font-medium mb-1">Email</span>
				<input
					type="email"
					name="email"
					required
					autocomplete="email"
					class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</label>
			<label class="block">
				<span class="block text-sm font-medium mb-1">Organization <span class="font-normal text-gray-500">(optional)</span></span>
				<input
					type="text"
					name="organization"
					autocomplete="organization"
					class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</label>
			<label class="block">
				<span class="block text-sm font-medium mb-1">Message <span class="font-normal text-gray-500">(optional)</span></span>
				<textarea
					name="message"
					rows="4"
					placeholder="A short note about why you would like a copy."
					class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
				></textarea>
			</label>
		</div>

		<div class="mt-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
			<button type="button" class="btn" data-aw-close-request-cv>Cancel</button>
			<button type="submit" class="btn btn-primary">
				<Icon name="tabler:mail" class="w-5 h-5 mr-1 -ml-1.5" />
				Send request
			</button>
		</div>
		<p class="mt-4 text-xs text-gray-500 dark:text-slate-500">
			This opens your email app with a message to <a class="underline" href={`mailto:${email}`}>{email}</a>.
		</p>
	</form>
</dialog>

<script define:vars={{ email }}>
	const dialog = document.getElementById('request-cv-dialog');
	const form = document.getElementById('request-cv-form');

	function openRequestCv() {
		if (dialog instanceof HTMLDialogElement) {
			dialog.showModal();
		}
	}

	function closeRequestCv() {
		if (dialog instanceof HTMLDialogElement) {
			dialog.close();
		}
	}

	document.querySelectorAll('[data-aw-open-request-cv]').forEach((el) => {
		el.addEventListener('click', (event) => {
			event.preventDefault();
			openRequestCv();
		});
	});

	document.querySelectorAll('[data-aw-close-request-cv]').forEach((el) => {
		el.addEventListener('click', closeRequestCv);
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) {
			closeRequestCv();
		}
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name') || '').trim();
		const requesterEmail = String(data.get('email') || '').trim();
		const organization = String(data.get('organization') || '').trim();
		const message = String(data.get('message') || '').trim();

		const lines = [
			`Name: ${name}`,
			`Email: ${requesterEmail}`,
			organization ? `Organization: ${organization}` : '',
			'',
			message || 'I would like to request a copy of your CV.',
		].filter((line, index, arr) => line !== '' || arr[index - 1] !== '');

		const subject = `CV request from ${name}`;
		const body = lines.join('\n');
		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		closeRequestCv();
		form.reset();
	});
</script>
