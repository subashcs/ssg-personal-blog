---
import { Icon } from 'astro-icon/components';

const email = 'subashsapkota59@gmail.com';
---

<div
	id="request-cv-drawer"
	class="fixed inset-0 z-50"
	role="dialog"
	aria-modal="true"
	aria-labelledby="request-cv-title"
	aria-hidden="true"
>
	<div
		class="drawer-backdrop absolute inset-0 bg-black/50"
		data-aw-close-request-cv
	></div>
	<aside
		id="request-cv-panel"
		class="absolute right-0 top-0 flex h-full w-full max-w-md flex-col border-l border-gray-200 bg-white text-gray-900 shadow-xl dark:border-zinc-700 dark:bg-zinc-900 dark:text-slate-200"
	>
		<form id="request-cv-form" class="flex h-full flex-col">
			<div class="flex items-start justify-between gap-4 border-b border-gray-200 px-6 py-5 dark:border-zinc-700">
				<div>
					<h2 id="request-cv-title" class="text-2xl font-bold font-heading">Request CV</h2>
					<p class="mt-2 text-sm text-gray-600 dark:text-slate-400">
						Share a few details and I’ll email you a copy of my CV.
					</p>
				</div>
				<button
					type="button"
					class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white rounded-lg p-1.5"
					data-aw-close-request-cv
					aria-label="Close request form"
				>
					<Icon name="tabler:x" class="w-5 h-5" />
				</button>
			</div>

			<div class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
				<label class="block">
					<span class="block text-sm font-medium mb-1">Name</span>
					<input
						type="text"
						name="name"
						required
						autocomplete="name"
						class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium mb-1">Email</span>
					<input
						type="email"
						name="email"
						required
						autocomplete="email"
						class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium mb-1"
						>Organization <span class="font-normal text-gray-500">(optional)</span></span
					>
					<input
						type="text"
						name="organization"
						autocomplete="organization"
						class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
				</label>
				<label class="block">
					<span class="block text-sm font-medium mb-1"
						>Message <span class="font-normal text-gray-500">(optional)</span></span
					>
					<textarea
						name="message"
						rows="4"
						placeholder="A short note about why you would like a copy."
						class="w-full rounded-md border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
					></textarea>
				</label>
				<p class="text-xs text-gray-500 dark:text-slate-500">
					This opens your email app with a message to <a class="underline" href={`mailto:${email}`}>{email}</a>.
				</p>
			</div>

			<div class="border-t border-gray-200 px-6 py-4 dark:border-zinc-700 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
				<button type="button" class="btn" data-aw-close-request-cv>Cancel</button>
				<button type="submit" class="btn btn-primary">
					<Icon name="tabler:mail" class="w-5 h-5 mr-1 -ml-1.5" />
					Send request
				</button>
			</div>
		</form>
	</aside>
</div>

<style is:global>
	#request-cv-drawer {
		visibility: hidden;
		pointer-events: none;
	}

	#request-cv-drawer.is-open {
		visibility: visible;
		pointer-events: auto;
	}

	#request-cv-drawer .drawer-backdrop {
		opacity: 0;
		transition: opacity 200ms ease;
	}

	#request-cv-drawer.is-open .drawer-backdrop {
		opacity: 1;
	}

	#request-cv-panel {
		transform: translateX(100%);
		transition: transform 300ms ease;
	}

	#request-cv-drawer.is-open #request-cv-panel {
		transform: translateX(0);
	}
</style>

<script define:vars={{ email }}>
	const drawer = document.getElementById('request-cv-drawer');
	const form = document.getElementById('request-cv-form');

	function openRequestCv() {
		if (!drawer) return;
		drawer.classList.add('is-open');
		drawer.setAttribute('aria-hidden', 'false');
		document.body.classList.add('overflow-hidden');
		const firstField = form?.querySelector('input');
		if (firstField instanceof HTMLElement) {
			firstField.focus();
		}
	}

	function closeRequestCv() {
		if (!drawer) return;
		drawer.classList.remove('is-open');
		drawer.setAttribute('aria-hidden', 'true');
		document.body.classList.remove('overflow-hidden');
	}

	document.querySelectorAll('[data-aw-open-request-cv]').forEach((el) => {
		el.addEventListener('click', (event) => {
			event.preventDefault();
			openRequestCv();
		});
	});

	document.querySelectorAll('[data-aw-close-request-cv]').forEach((el) => {
		el.addEventListener('click', closeRequestCv);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && drawer?.classList.contains('is-open')) {
			closeRequestCv();
		}
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name') || '').trim();
		const requesterEmail = String(data.get('email') || '').trim();
		const organization = String(data.get('organization') || '').trim();
		const message = String(data.get('message') || '').trim();

		const lines = [
			`Name: ${name}`,
			`Email: ${requesterEmail}`,
			organization ? `Organization: ${organization}` : '',
			'',
			message || 'I would like to request a copy of your CV.',
		].filter((line, index, arr) => line !== '' || arr[index - 1] !== '');

		const subject = `CV request from ${name}`;
		const body = lines.join('\n');
		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		closeRequestCv();
		form.reset();
	});
</script>
