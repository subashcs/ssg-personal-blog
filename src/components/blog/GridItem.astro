---
import { Image } from 'astro:assets';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

const { post } = Astro.props;

const image = await findImage(post.image);
---

<article class="mb-6 rounded transition ease-in-out duration-200 hover:bg-gray-50 dark:hover:bg-zinc-800/60">
	<a href={getPermalink(post.slug, 'post')} class="decoration-none transition">
		<div class="flex flex-col md:flex-row">
			{
				image && (
					<Image
						src={image}
						class="object-cover w-full lg:w-[500px] rounded shadow-l"
						alt={post.title}
					/>
				)
			}
			<div class="w-full md:w-3/4 md:pl-3 md:ml-2 px-2">
				<h3 class="mt-2 text-xl font-bold leading-snug sm:text-2xl font-heading">
						{post.title}
				</h3>
				<div class="mb-2"><span class="text-sm text-gray-600 bg-gray-100 dark:text-slate-300 dark:bg-zinc-800 rounded px-1.5 py-0.5">Published Date: {post.publishDate}</span></div>
				<p class="text-gray-600 dark:text-slate-400">{post.excerpt || post.description}</p>
			</div>
		</div>
	</a>
</article>
