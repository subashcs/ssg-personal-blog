---
import { Image } from 'astro:assets';

import Card from '~/components/atoms/Card.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

const { post } = Astro.props;

const image = await findImage(post.image);
---

<article>
	<a href={getPermalink(post.slug, 'post')} class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-2xl">
		<Card hover class="flex flex-col md:flex-row gap-4 md:gap-5 p-5 sm:p-6">
			{
				image && (
					<Image
						src={image}
						class="w-full md:w-52 lg:w-64 h-auto shrink-0 rounded-xl bg-gray-50 dark:bg-zinc-800"
						alt={post.title}
					/>
				)
			}
			<div class="min-w-0 flex-1">
				<h3 class="text-xl sm:text-2xl font-bold leading-snug font-heading text-gray-900 dark:text-slate-100 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">
					{post.title}
				</h3>
				<p class="mt-2 text-sm text-gray-500 dark:text-slate-400">
					<time datetime={post.publishDate}>{post.publishDate}</time>
				</p>
				<p class="mt-2 text-gray-600 dark:text-slate-400">{post.excerpt || post.description}</p>
			</div>
		</Card>
	</a>
</article>
