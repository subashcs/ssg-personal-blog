---
import { Image } from 'astro:assets';
import Card from '~/components/atoms/Card.astro';
import PostTags from '~/components/atoms/Tags.astro';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

const { post } = Astro.props;

const image = await findImage(post.image);
---

<article>
	<Card hover class={`overflow-hidden ${image ? 'md:grid md:grid-cols-2 md:items-start' : ''}`}>
		{
			image && (
				<a class="block bg-gray-50 dark:bg-zinc-800" href={getPermalink(post.slug, 'post')}>
					<Image src={image} class="w-full h-auto" alt={post.title} />
				</a>
			)
		}
		<div class="p-5 sm:p-6">
			<h2 class="text-lg sm:text-xl md:text-2xl font-bold leading-snug mb-3 font-heading">
				<a
					class="text-gray-900 dark:text-slate-100 hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
					href={getPermalink(post.slug, 'post')}
				>
					{post.title}
				</a>
			</h2>
			<p class="text-base md:text-lg leading-relaxed text-gray-600 dark:text-slate-400">
				{post.excerpt || post.description}
			</p>
			<footer class="mt-4">
				<p class="text-sm text-gray-500 dark:text-slate-400">
					<time datetime={post.publishDate}>{getFormattedDate(post.publishDate)}</time>
					{' · '}
					{Math.ceil(post.readingTime)} min read
				</p>
				<div class="mt-4">
					<PostTags tags={post.tags} />
				</div>
			</footer>
		</div>
	</Card>
</article>
