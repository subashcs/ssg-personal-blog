---
import { Image } from 'astro:assets';
import PostTags from '~/components/atoms/Tags.astro';
import SocialShare from '~/components/atoms/SocialShare.astro';
import PostComments from '~/components/blog/PostComments.astro';

import { getFormattedDate } from '~/utils/utils';

const { post, url } = Astro.props;
---

<section class="py-8 sm:py-12 lg:py-16 mx-auto" id="blog-section">
	<article>
		<header class="px-4 sm:px-6 max-w-4xl mx-auto text-center">
			<p class="text-sm sm:text-base text-gray-500 dark:text-slate-400">
				<time datetime={post.publishDate}>{getFormattedDate(post.publishDate)}</time> ~ {Math.ceil(post.readingTime)} min
				read
			</p>
			<h1 class="mt-3 text-3xl sm:text-4xl font-bold leading-tight tracking-tight mb-8 font-heading">
				{post.title}
			</h1>
			{
				post.image ? (
					<Image
						src={post.image}
						class="w-full h-auto mx-auto mb-2 rounded-md bg-gray-400 dark:bg-zinc-700 object-cover"
						sizes="(max-width: 896px) 100vw, 896px"
						alt={post.description}
						loading="eager"
						width={900}
						height={506}
					/>
				) : (
					<div class="border-t border-gray-200 dark:border-zinc-700" />
				)
			}
		</header>
		<div
			class="post-container mx-auto px-4 sm:px-6 max-w-4xl mt-8 prose prose-lg dark:prose-invert prose-headings:font-heading prose-headings:leading-tight prose-headings:tracking-tight prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-md prose-pre:max-w-full"
		>
			{post.Content ? <post.Content /> : <Fragment set:html={post.body} />}
		</div>
		<div class="mx-auto px-4 sm:px-6 max-w-4xl mt-10 flex justify-between flex-col sm:flex-row gap-4">
			<PostTags tags={post.tags} class="mr-5" />
			<SocialShare url={url} text={post.title} class="sm:mt-1 align-middle text-gray-500 dark:text-slate-400" />
		</div>
	</article>
	<PostComments />
</section>
