---
import { getPermalink } from '~/utils/permalinks';

const { tags, class: className = '' } = Astro.props;
---

{
	tags && Array.isArray(tags) && (
		<ul class:list={['flex flex-wrap gap-2', className]}>
			{tags.map((tag) => (
				<li>
					<a
						href={getPermalink(tag, 'tag')}
						class="inline-block px-2.5 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 dark:bg-zinc-700/80 dark:text-slate-300 hover:bg-blue-50 hover:text-blue-700 dark:hover:bg-zinc-600 dark:hover:text-slate-100"
					>
						{tag}
					</a>
				</li>
			))}
		</ul>
	)
}
